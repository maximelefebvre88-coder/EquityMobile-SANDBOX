    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Metallic Steel Dark Gradient Base -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A2228" />
                <item android:offset="0.3" android:color="#0F1418" />
                <item android:offset="1.0" android:color="#040506" />
            </gradient>
