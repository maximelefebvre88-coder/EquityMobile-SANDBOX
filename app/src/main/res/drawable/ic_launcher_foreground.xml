<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stylish Teal Accent Circle Border (matching the top-left of the app) -->
    <path
        android:pathData="M 54,54 m -34,0 a 34,34 0 1,1 68,0 a 34,34 0 1,1 -68,0"
        android:strokeWidth="1.5"
        android:strokeColor="#00FF88" />

    <!-- Scaled & Centered Artwork Group so everything fits perfectly inside 66dp/72dp circle -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.65"
        android:scaleY="0.65"
        android:translateX="-1.0"
        android:translateY="1.3">

        <!-- Glowing Green Compass Bezel (Left Shifted) -->
        <path
            android:pathData="M 44,52 m -24,0 a 24,24 0 1,1 48,0 a 24,24 0 1,1 -48,0"
            android:strokeWidth="2.5"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="20"
                    android:startY="28"
                    android:endX="68"
                    android:endY="76"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00FFA6" />
                    <item android:offset="0.5" android:color="#00E676" />
                    <item android:offset="1.0" android:color="#00C853" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Compass Inner Ticks / Crosshair -->
        <path
            android:pathData="M 44,22 V 26 M 44,78 V 82 M 14,52 H 18 M 70,52 H 74"
            android:strokeWidth="1.5"
            android:strokeColor="#6600FF88"
            android:strokeLineCap="round" />

        <!-- Compass Directions Chevron Pointer (Top and Bottom) -->
        <path
            android:pathData="M 44,28 L 40,36 L 44,34 L 48,36 Z"
            android:fillColor="#00FF88" />
        <path
            android:pathData="M 44,76 L 40,68 L 44,70 L 48,68 Z"
            android:fillColor="#00E676" />

        <!-- Highly Stylized Bold Upward Trend Line -->
        <path
            android:pathData="M 18,74 L 34,50 L 42,56 L 76,24"
            android:strokeWidth="4.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="18"
                    android:startY="74"
                    android:endX="76"
                    android:endY="24"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00E676" />
                    <item android:offset="1.0" android:color="#B9F6CA" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Trend Arrowhead (Vibrant Neo Green Triangle) -->
        <path
            android:pathData="M 78,22 L 62,25 L 75,38 Z"
            android:fillColor="#B9F6CA" />

        <!-- "EQ" Bold Brand Symbols -->
        <!-- E Symbol Paths -->
        <path
            android:pathData="M 70,46 H 79 M 70,53 H 77 M 70,60 H 79 M 70,46 V 60"
            android:strokeWidth="3.0"
            android:strokeColor="#00FF88"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Q Symbol Paths -->
        <path
            android:pathData="M 85,53 m -6,0 a 6,6 0 1,1 12,0 a 6,6 0 1,1 -12,0"
            android:strokeWidth="3.0"
            android:strokeColor="#00FF88"
            android:strokeLineCap="round" />
        <path
            android:pathData="M 88,58 L 93,64"
            android:strokeWidth="3.0"
            android:strokeColor="#00FF88"
            android:strokeLineCap="round" />

        <!-- Stylized "MOBILE" branding bar + gear -->
        <path
            android:pathData="M 68,69 H 78"
            android:strokeWidth="1.2"
            android:strokeColor="#9900FF88"
            android:strokeLineCap="round" />

        <!-- Tiny Gear Icon -->
        <!-- Center circle -->
        <path
            android:pathData="M 84,69 m -2.5,0 a 2.5,2.5 0 1,1 5,0 a 2.5,2.5 0 1,1 -5,0"
            android:strokeWidth="1.2"
            android:strokeColor="#00FF88" />
        <!-- Gear Teethes -->
        <path
            android:pathData="M 84,65 V 66 M 84,72 V 73 M 80,69 H 81 M 87,69 H 88 M 81.5,66.5 L 82.3,67.3 M 85.7,70.7 L 86.5,71.5 M 81.5,71.5 L 82.3,70.7 M 85.7,66.5 L 86.5,67.3"
            android:strokeWidth="1.2"
            android:strokeColor="#00FF88"
            android:strokeLineCap="round" />

    </group>

</vector>
