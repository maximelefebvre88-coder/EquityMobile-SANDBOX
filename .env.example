# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FINNHUB_API_KEY: Finnhub API Key used directly in the app.
# Securely configured in the AI Studio Secrets panel.
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY_HERE

# FIREBASE_API_KEY: Firebase Web API Key for programmatic initialization
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE

# FIREBASE_PROJECT_ID: Firebase Project ID
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_HERE

# FIREBASE_APP_ID: Firebase Application ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID_HERE

# FIREBASE_CLIENT_ID: Google OAuth 2.0 Web Client ID for Google Sign-In
FIREBASE_CLIENT_ID=YOUR_FIREBASE_CLIENT_ID_HERE
